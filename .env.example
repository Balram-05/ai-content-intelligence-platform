# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# FastAPI Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
API_V1_PREFIX=/api/v1

# MongoDB Configuration
# For Local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=content_intelligence_db
MONGODB_MAX_CONNECTIONS=10
MONGODB_MIN_CONNECTIONS=1
MONGODB_CONNECT_TIMEOUT_MS=5000

# Streamlit Frontend Configuration
STREAMLIT_PORT=8501
FASTAPI_BASE_URL=http://127.0.0.1:8000

# LLM / AI Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Search & MCP Configuration
SEARCH_TIMEOUT_SECONDS=10.0
SEARCH_DEFAULT_LIMIT=5
SEARCH_MAX_LIMIT=20

# Search Provider Selection (tavily / serper / duckduckgo, newsapi / googlenews, google_trends / github_trends, semantic_scholar / arxiv)
SEARCH_WEB_PROVIDER=tavily
SEARCH_NEWS_PROVIDER=newsapi
SEARCH_TRENDS_PROVIDER=google_trends
SEARCH_PAPERS_PROVIDER=semantic_scholar

# Optional External Search API Credentials (leave empty or unset if using unauthenticated public fallbacks)
TAVILY_API_KEY=your_tavily_api_key_here
NEWS_API_KEY=your_news_api_key_here
SERPER_API_KEY=your_serper_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# MCP Server Configuration
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_SERVER_NAME=search-mcp-server

