# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# FastAPI Server Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
API_V1_PREFIX=/api/v1

# MongoDB Configuration
# For Local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=content_intelligence_db
MONGODB_MAX_CONNECTIONS=10
MONGODB_MIN_CONNECTIONS=1
MONGODB_CONNECT_TIMEOUT_MS=5000

# Streamlit Frontend Configuration
STREAMLIT_PORT=8501
FASTAPI_BASE_URL=http://127.0.0.1:8000

# LLM / AI Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
